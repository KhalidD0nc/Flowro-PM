# Firebase (Client-side - NEXT_PUBLIC prefix)
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abc123

# Firebase Admin (Server-side - NO NEXT_PUBLIC prefix)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# OpenRouter
OPENROUTER_API_KEY=sk-or-your-api-key-here
OPENROUTER_MODEL=openai/gpt-oss-120b:free
OPENROUTER_MODEL_BUILD=moonshotai/kimi-k2
OPENROUTER_MODEL_PROMPT_ENHANCER=google/gemini-3-flash-preview
OPENROUTER_MODEL_CLARIFICATION=google/gemini-3-flash-preview
OPENROUTER_MODEL_PRD=openai/gpt-5.4-mini

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Generated apps output directory (defaults to ~/Desktop/Flowro-Apps)
FLOWRO_GENERATED_APPS_PATH=/Users/YOUR_USERNAME/Desktop/Flowro-Apps

# Supabase Management API (server-side only)
# SUPABASE_ACCESS_TOKEN is required for automatic organization/project provisioning.
# Set either SUPABASE_ORG_ID or SUPABASE_ORG_SLUG to use an existing organization.
# If neither organization value is set, Flowro creates a new organization for the generated app.
SUPABASE_ACCESS_TOKEN=sbp_your-personal-access-token
SUPABASE_ORG_ID=
SUPABASE_ORG_SLUG=
SUPABASE_PROJECT_REGION=us-east-1
