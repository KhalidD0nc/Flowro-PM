rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Helper Functions
    // =========================================================================

    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if user owns the resource (by userId field)
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Check if user owns a project by projectId
    function isProjectOwner(projectId) {
      return isAuthenticated()
             && exists(/databases/$(database)/documents/projects/$(projectId))
             && get(/databases/$(database)/documents/projects/$(projectId)).data.userId == request.auth.uid;
    }

    // Check if user is an active collaborator on a project
    // Checks that user is either the owner or in the collaboratorUserIds array
    // The collaboratorUserIds array is maintained by the application layer when
    // collaborators are added/removed (FieldValue.arrayUnion/arrayRemove)
    function hasProjectAccess(projectId) {
      let project = get(/databases/$(database)/documents/projects/$(projectId));
      return isAuthenticated()
             && project != null
             && (
               project.data.userId == request.auth.uid
               || request.auth.uid in project.data.collaboratorUserIds
             );
    }

    // Check if user can edit - owner only for now
    // Application layer enforces editor/admin permissions
    function canEditProject(projectId) {
      return isProjectOwner(projectId);
    }

    // =========================================================================
    // Projects Collection (with messages subcollection)
    // =========================================================================

    match /projects/{projectId} {
      // Allow read if user owns OR is an active collaborator
      allow read: if hasProjectAccess(projectId);

      // Allow create if authenticated and setting self as owner
      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid;

      // Allow update if user can edit AND userId is not changed
      // Only owner can modify collaborators array
      allow update: if canEditProject(projectId)
                    && request.resource.data.userId == resource.data.userId
                    && (request.resource.data.userId == request.auth.uid
                        || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['collaborators']));

      // Allow delete if user owns the project (only owner can delete)
      allow delete: if isOwner(resource.data.userId);

      // ----- Messages Subcollection -----
      // Stores chat history (unlimited messages, avoids 1MB limit)
      match /messages/{messageId} {
        // Collaborators can read messages
        allow read: if hasProjectAccess(projectId);

        // Editors can create messages
        allow create: if canEditProject(projectId);

        // Messages are immutable (no updates allowed)
        allow update: if false;

        // Only owner can delete messages
        allow delete: if isProjectOwner(projectId);
      }
    }

    // =========================================================================
    // Blueprints Collection (with history subcollection)
    // =========================================================================

    match /blueprints/{blueprintId} {
      // Helper to get parent project
      function getProject() {
        return get(/databases/$(database)/documents/projects/$(resource.data.projectId));
      }

      function getProjectForCreate() {
        return get(/databases/$(database)/documents/projects/$(request.resource.data.projectId));
      }

      // Collaborators can read blueprints
      allow read: if hasProjectAccess(resource.data.projectId);

      // Only project owner can create blueprints
      // Enforce 1:1: blueprintId MUST equal projectId (prevents duplicate blueprints)
      allow create: if isAuthenticated()
                    && blueprintId == request.resource.data.projectId
                    && isProjectOwner(request.resource.data.projectId);

      // Editors can update blueprints
      allow update: if canEditProject(resource.data.projectId);

      // Only owner can delete blueprints
      allow delete: if isProjectOwner(resource.data.projectId);

      // ----- History Subcollection -----
      // Stores version snapshots (auto-created on blueprint changes)
      match /history/{snapshotId} {
        // Collaborators can read history
        allow read: if hasProjectAccess(get(/databases/$(database)/documents/blueprints/$(blueprintId)).data.projectId);

        // Editors can create history snapshots
        allow create: if canEditProject(get(/databases/$(database)/documents/blueprints/$(blueprintId)).data.projectId);

        // History snapshots are immutable (no updates)
        allow update: if false;

        // Only owner can delete history (for cascade delete)
        allow delete: if isProjectOwner(get(/databases/$(database)/documents/blueprints/$(blueprintId)).data.projectId);
      }
    }

    // =========================================================================
    // Users Collection
    // =========================================================================

    match /Users/{userId} {
      // Users can only read their own document
      allow read: if isOwner(userId);

      // Users can create their own document on signup
      allow create: if isAuthenticated() && request.auth.uid == userId;

      // Users can update their own document
      allow update: if isOwner(userId);

      // Users should not be deleted through client
      allow delete: if false;
    }

    // =========================================================================
    // Share Tokens (public read for valid tokens, authenticated write)
    // =========================================================================

    match /shareTokens/{tokenId} {
      // Anyone with the token can read (for public share links)
      allow read: if true;

      // Only authenticated users can create share tokens
      allow create: if isAuthenticated();

      // Only the creator can update or delete share tokens
      allow update, delete: if isAuthenticated()
                            && resource.data.createdBy == request.auth.uid;
    }

  }
}
